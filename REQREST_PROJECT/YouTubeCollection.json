              "const Userid = Math.floor(Math.random() * 10 + 1);\r",
              "console.log(\"Userid: \" + Userid);\r",
              "pm.globals.set(\"Userid\", Userid);\r",
              "\r",
              "//crea variable environment\r",
              "pm.environment.set(\"Userid\", Userid);\r",
              "\r",
